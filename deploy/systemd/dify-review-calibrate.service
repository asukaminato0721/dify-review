# Weekly: add new review history, judge what became of the bot's comments,
# and rewrite backtest/report.md. Applies nothing and commits nothing:
# review `git diff backtest/`, then `dify-review backtest --apply` if the
# suggested thresholds look right.
[Unit]
Description=dify-codereview feedback and backtest
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/gitproject/dify-review
ExecStart=%h/gitproject/dify-review/target/release/dify-review collect --since 14d --append
ExecStart=%h/gitproject/dify-review/target/release/dify-review feedback --since 30d
ExecStart=%h/gitproject/dify-review/target/release/dify-review backtest
